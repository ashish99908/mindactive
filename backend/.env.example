[TEMPLATE]
# Copy to .env and fill in real values

# Required: JWT secret for token signing
JWT_SECRET=change-me-to-any-long-random-string

# Required for AI Analysis page (get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# URL of the deployed frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# For production with PostgreSQL (Neon): set DATABASE_URL to your Neon connection string
# For local development: leave unset to use SQLite (default)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# For local SQLite development only (ignored if DATABASE_URL is set):
# DB_PATH=./database/cognitive_gaming.db
