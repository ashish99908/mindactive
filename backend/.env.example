# Copy to .env and fill in real values
JWT_SECRET=change-me-to-any-long-random-string
GROQ_API_KEY=your_groq_api_key_here

# URL of the deployed frontend (for CORS). Local dev default shown.
FRONTEND_URL=http://localhost:3000

# Optional: absolute path for the SQLite file. Set this to a persistent
# disk mount (e.g. /var/data/cognitive_gaming.db) when deploying with a disk.
# DB_PATH=/var/data/cognitive_gaming.db
